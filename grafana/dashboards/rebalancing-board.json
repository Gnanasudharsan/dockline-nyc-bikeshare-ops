          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cube"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT station_name AS station, latitude, longitude, imbalance_state AS state, recommended_action AS action, bikes_to_move AS bikes_to_move FROM fleet_status WHERE priority_rank IS NOT NULL GROUP BY 1, 2, 3, 4, 5, 6"
        }
      ],
      "options": {
