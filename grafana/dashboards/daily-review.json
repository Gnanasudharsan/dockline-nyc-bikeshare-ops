      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cube"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT CAST(hour_of_day AS TEXT) AS hour, MEASURE(empty_share) AS \"Empty share\", MEASURE(full_share) AS \"Full share\" FROM station_hourly WHERE $__timeFilter(hour_start) GROUP BY hour_of_day ORDER BY hour_of_day"
        }
      ],
      "options": {
        "orientation": "vertical",
        "stacking": "none",
        "showValue": "auto",
        "xTickLabelRotation": 0,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "fixed",
            "fixedColor": "#1B5FD1"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          }
        },
        "overrides": [
