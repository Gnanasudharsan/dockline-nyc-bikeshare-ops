    {
      "type": "timeseries",
      "title": "Availability rate by day and borough",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cube"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cube"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT date_trunc('day', service_date) AS time, borough AS metric, MEASURE(availability_rate) AS value FROM daily_kpis WHERE $__timeFilter(service_date) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "always",
            "pointSize": 6,
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisBorderShow": false
          },
          "max": 1
        },
        "overrides": []
      },
      "id": 7
    },
    {
      "type": "table",
      "title": "Borough summary for the selected range",
      "description": "",
      "gridPos": {
        "x": 14,
        "y": 4,
        "w": 10,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cube"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cube"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT borough AS \"Borough\", MEASURE(availability_rate) AS \"Availability\", MEASURE(empty_share) AS \"Empty share\", MEASURE(full_share) AS \"Full share\", MEASURE(bikes_added) AS \"Bikes added\", MEASURE(bikes_removed) AS \"Bikes removed\" FROM daily_kpis WHERE $__timeFilter(service_date) GROUP BY 1 ORDER BY 2"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Availability|.*share"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "id": 8
    },
    {
      "type": "barchart",
      "title": "Empty and full share by hour of day (local)",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 14,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cube"
