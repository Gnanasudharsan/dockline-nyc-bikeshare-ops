          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT weather.weather_condition AS condition, MEASURE(station_hourly.availability_rate) AS \"Availability\" FROM station_hourly CROSS JOIN weather WHERE $__timeFilter(station_hourly.hour_start) GROUP BY 1 ORDER BY 1"
