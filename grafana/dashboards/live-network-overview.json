    {
      "type": "geomap",
      "title": "Station imbalance at ${at_bucket} (orange = starving · gray = balanced · blue = flooding · purple = offline)",
      "description": "Each dot is a station at the end of the selected time range (rewind by changing the time picker). Orange = starving, gray = balanced, blue = flooding, purple = offline. Hover for the label and counts.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 16
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cube"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cube"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT stations.station_name AS station, stations.latitude AS latitude, stations.longitude AS longitude, station_status.imbalance_state AS state, MEASURE(station_status.bikes_available) AS bikes, MEASURE(station_status.docks_available) AS docks FROM station_status CROSS JOIN stations WHERE station_status.bucket_start = '${at_bucket}' GROUP BY 1, 2, 3, 4"
        }
      ],
      "options": {
        "view": {
          "id": "coords",
          "lat": 40.735,
          "lon": -73.96,
          "zoom": 11.2
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": true
        },
        "tooltip": {
          "mode": "details"
        },
        "basemap": {
          "type": "carto",
          "name": "Basemap",
          "config": {
            "theme": "light",
            "showLabels": true
          }
        },
        "layers": [
          {
            "type": "markers",
            "name": "Stations",
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "config": {
              "showLegend": false,
              "style": {
                "color": {
                  "field": "state",
                  "fixed": "#A9B3C1"
                },
                "size": {
                  "fixed": 4
                },
                "opacity": 0.85,
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/circle.svg"
                }
              }
            },
            "tooltip": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "state"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "starving": {
                        "text": "starving",
                        "color": "#E0701F",
                        "index": 0
                      },
                      "balanced": {
                        "text": "balanced",
                        "color": "#A9B3C1",
                        "index": 1
                      },
                      "flooding": {
                        "text": "flooding",
                        "color": "#2357C6",
                        "index": 2
                      },
                      "offline": {
                        "text": "offline",
                        "color": "#7A6F9B",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#A9B3C1"
                }
              }
            ]
          }
        ]
      },
      "id": 9
    },
