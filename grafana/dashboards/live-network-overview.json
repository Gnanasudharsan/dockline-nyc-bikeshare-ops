          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT date_trunc('minute', station_status.bucket_start) AS time, stations.borough AS metric, MEASURE(station_status.availability_rate) AS value FROM station_status CROSS JOIN stations WHERE $__timeFilter(station_status.bucket_start) GROUP BY 1, 2 ORDER BY 1"
