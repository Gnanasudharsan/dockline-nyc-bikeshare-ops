{
  "uid": "dockline-live",
  "title": "Live Network Overview",
  "description": "Live state of every Citi Bike station. Headline numbers are live; the map and charts follow the time picker for rewind.",
  "tags": [
    "dockline"
  ],
  "timezone": "America/New_York",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "schemaVersion": 41,
  "version": 1,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "dockline"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "title": "Dockline"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Pipeline events",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "warehouse"
        },
        "enable": true,
        "iconColor": "#C4362B",
        "target": {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT occurred_at AS time, title AS text, event_type || ',' || severity AS tags FROM ops.pipeline_events WHERE $__timeFilter(occurred_at) ORDER BY occurred_at"
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "at_bucket",
        "label": "Map time (UTC)",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "warehouse"
        },
        "query": "SELECT to_char((date_bin('5 minutes', least('${__to:date:iso}'::timestamptz, now()), timestamptz '2000-01-01') - interval '10 minutes') AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS\"Z\"')",
        "definition": "last fully built 5-minute bucket at the end of the time range",
        "refresh": 2,
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "sort": 0
      }
    ]
  },
