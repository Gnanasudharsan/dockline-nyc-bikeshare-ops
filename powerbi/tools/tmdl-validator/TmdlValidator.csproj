<Project Sdk="Microsoft.NET.Sdk">
  <!-- Parses a TMDL semantic model with Microsoft's own serializer (the same library
       Power BI Desktop uses) and reports syntax and model errors. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AnalysisServices" Version="19.118.3" />
  </ItemGroup>
</Project>
