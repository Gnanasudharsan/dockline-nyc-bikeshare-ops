model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

annotation PBI_QueryOrder = ["DbHost", "DbPort", "DbName", "fleet_status", "station_hourly", "chronic_stations", "Station", "Borough", "Date", "Hour", "Weather"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table fleet_status
ref table station_hourly
ref table chronic_stations
ref table Station
ref table Borough
ref table Date
ref table Hour
ref table Weather

ref role 'Borough - Manhattan'
ref role 'Borough - Brooklyn'
ref role 'Borough - Queens'
ref role 'Borough - Bronx'
ref role 'Borough - Staten Island'
ref role 'Borough - Jersey City'
ref role 'Borough - Hoboken'

ref cultureInfo en-US
