/// Station activity per clock hour. Mirrors the Cube cube station_hourly.
table station_hourly
	lineageTag: 213ac3af-bd81-5115-9adf-06d4de9579d3

	/// Station-minutes in service.
	measure in_service_station_minutes = SUM(station_hourly[in_service_minutes])
		formatString: #,0
		displayFolder: History\Minutes
		lineageTag: b38c9a04-4536-5fc2-926a-7fc14fbb92fc

	/// Minutes stations had no bike to rent while renting.
	measure empty_station_minutes = SUM(station_hourly[empty_minutes])
		formatString: #,0
		displayFolder: History\Minutes
		lineageTag: 38af386d-effc-57b1-b6a8-5fef6a635d6c

	/// Minutes stations had no free dock while returning.
	measure full_station_minutes = SUM(station_hourly[full_minutes])
		formatString: #,0
		displayFolder: History\Minutes
		lineageTag: 05ecf3ed-844a-5aa7-8481-b5dac3653c04

	/// In-service minutes with at least one bike and one dock.
	measure available_station_minutes = SUM(station_hourly[available_minutes])
		formatString: #,0
		displayFolder: History\Minutes
		lineageTag: e6ea9bf9-983f-53b1-8e7a-c0b4b6136152

	/// Station-minutes not in service.
	measure offline_station_minutes = SUM(station_hourly[offline_minutes])
		formatString: #,0
		displayFolder: History\Minutes
		lineageTag: f1c93cdd-518e-5bb6-870c-687090fff1e9

	/// Share of in-service station-minutes with at least one bike and one dock.
	measure availability_rate = DIVIDE([available_station_minutes], [in_service_station_minutes])
		formatString: 0.0%
		displayFolder: History\Rates
		lineageTag: 3539641a-6ebd-56c5-8a2c-0aabb2dee874

	/// Share of in-service station-minutes with no bike.
	measure empty_share = DIVIDE([empty_station_minutes], [in_service_station_minutes])
		formatString: 0.0%
		displayFolder: History\Rates
		lineageTag: 2b6e0091-b7e0-58ba-8a33-d09dfa13bd24

	/// Share of in-service station-minutes with no free dock.
	measure full_share = DIVIDE([full_station_minutes], [in_service_station_minutes])
		formatString: 0.0%
		displayFolder: History\Rates
		lineageTag: 7ba95274-2b26-54e5-a85e-cec3ab2a74ac

	/// Change in bikes on hand. Includes rebalancing trucks; not trips.
	measure net_flow = SUM(station_hourly[net_flow_bikes])
		formatString: #,0
		displayFolder: History\Flow
		lineageTag: 4ad25a4a-a2e9-5939-a4fe-818a9f281aa1

	/// Sum of positive 5-minute changes.
	measure bikes_added = SUM(station_hourly[added_bikes])
		formatString: #,0
		displayFolder: History\Flow
		lineageTag: 0c98143b-786e-5567-a1d1-02425ffdeb3a

	/// Sum of negative 5-minute changes (as a positive number).
	measure bikes_removed = SUM(station_hourly[removed_bikes])
		formatString: #,0
		displayFolder: History\Flow
		lineageTag: 6f0c2b06-6cac-5e14-a331-7c16293633ee

	/// Station-hours observed.
	measure station_hours = COUNTROWS(station_hourly)
		formatString: #,0
		displayFolder: History\Minutes
		lineageTag: 731883f1-9bcf-51c1-b88d-a7f616fc9e6e

	/// Join key.
	column station_key
		dataType: string
		isHidden
		lineageTag: c0c59bc3-ecba-59e6-9214-2c0619cdccc8
		summarizeBy: none
		sourceColumn: station_key

		annotation SummarizationSetBy = Automatic

	/// Join key.
	column date_key
		dataType: int64
		isHidden
		lineageTag: 74993cfe-13f3-5403-ae82-fb32d0812e5b
		summarizeBy: none
		sourceColumn: date_key

		annotation SummarizationSetBy = Automatic

	/// Join key.
	column hour_of_day
		dataType: int64
		isHidden
		lineageTag: 6a8361b8-854a-585f-8c8d-ccdd724f26c0
		summarizeBy: none
		sourceColumn: hour_of_day

		annotation SummarizationSetBy = Automatic

	/// Join key.
	column weather_hour_key
		dataType: int64
		isHidden
		lineageTag: 96c738ca-c0f4-5b97-ba56-bb86e9d025e2
		summarizeBy: none
		sourceColumn: weather_hour_key

		annotation SummarizationSetBy = Automatic

	/// Hour start, New York time.
	column hour_start_local
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn
		lineageTag: e415148e-4d92-5b69-84d5-a7bb6ec1327a
		summarizeBy: none
		sourceColumn: hour_start_local

		annotation SummarizationSetBy = Automatic

	/// Weekday 7–10 or 16–20 local time.
	column is_peak_period
		dataType: boolean
		lineageTag: 5ba0d8b3-225b-5a03-953a-c5681a0e6190
		summarizeBy: none
		sourceColumn: is_peak_period

		annotation SummarizationSetBy = Automatic

	column observed_minutes
		dataType: int64
		isHidden
		lineageTag: 86bfdaff-0370-5aa8-b8b1-a33ab0574156
		summarizeBy: none
		sourceColumn: observed_minutes

		annotation SummarizationSetBy = Automatic

	column in_service_minutes
		dataType: int64
		isHidden
		lineageTag: 7e4c5444-6ede-59ab-8bf5-62c90b0f46c6
		summarizeBy: none
		sourceColumn: in_service_minutes

		annotation SummarizationSetBy = Automatic

	column empty_minutes
		dataType: int64
		isHidden
		lineageTag: bd859c04-24f6-58e7-95f7-ba50dd234bb7
		summarizeBy: none
		sourceColumn: empty_minutes

		annotation SummarizationSetBy = Automatic

	column full_minutes
		dataType: int64
		isHidden
		lineageTag: 7ce1121e-edaf-59aa-b60f-7679c9ce741b
		summarizeBy: none
		sourceColumn: full_minutes

		annotation SummarizationSetBy = Automatic

	column available_minutes
		dataType: int64
		isHidden
		lineageTag: fe3d0eb8-4cc8-534a-950d-a6e7d261a086
		summarizeBy: none
		sourceColumn: available_minutes

		annotation SummarizationSetBy = Automatic

	column offline_minutes
		dataType: int64
		isHidden
		lineageTag: 481f7ebb-84fe-5aa5-b5ed-4abddf8572af
		summarizeBy: none
		sourceColumn: offline_minutes

		annotation SummarizationSetBy = Automatic

	column avg_station_bikes
		dataType: double
		isHidden
		lineageTag: f04d4cf7-6cc4-5e04-a97f-1cf7af0fc87c
		summarizeBy: none
		sourceColumn: avg_station_bikes

		annotation SummarizationSetBy = Automatic

	column avg_station_docks
		dataType: double
		isHidden
		lineageTag: b1c8ba07-9d4c-5608-b2cf-28b0fd420604
		summarizeBy: none
		sourceColumn: avg_station_docks

		annotation SummarizationSetBy = Automatic

	column avg_station_fill_ratio
		dataType: double
		isHidden
		lineageTag: 882d4e48-a77c-56a6-93ac-c7cfebac9be2
		summarizeBy: none
		sourceColumn: avg_station_fill_ratio

		annotation SummarizationSetBy = Automatic

	column net_flow_bikes
		dataType: int64
		isHidden
		lineageTag: 19fcad7d-0b86-5982-9cfe-60418a7f2303
		summarizeBy: none
		sourceColumn: net_flow_bikes

		annotation SummarizationSetBy = Automatic

	column added_bikes
		dataType: int64
		isHidden
		lineageTag: ffa388df-04e8-5d52-a081-f59f1d3c5d62
		summarizeBy: none
		sourceColumn: added_bikes

		annotation SummarizationSetBy = Automatic

	column removed_bikes
		dataType: int64
		isHidden
		lineageTag: b665a973-d75b-50ba-a3e3-19de0e62c25b
		summarizeBy: none
		sourceColumn: removed_bikes

		annotation SummarizationSetBy = Automatic

	/// State at the end of the hour.
	column imbalance_state_end
		dataType: string
		lineageTag: fcbdc815-772e-5bf8-8af3-aa4a0a3e549e
		summarizeBy: none
		sourceColumn: imbalance_state_end

		annotation SummarizationSetBy = Automatic

	partition station_hourly = m
		mode: directQuery
		source =
				let
				    Source = PostgreSQL.Database(DbHost & ":" & Number.ToText(DbPort), DbName),
				    Data = Source{[Schema = "bi", Item = "station_hourly"]}[Data]
				in
				    Data

	annotation PBI_ResultType = Table
