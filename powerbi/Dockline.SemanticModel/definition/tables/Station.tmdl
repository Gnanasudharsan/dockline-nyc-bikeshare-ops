	partition Station = m
		mode: directQuery
		source =
				let
				    Source = PostgreSQL.Database(DbHost & ":" & Number.ToText(DbPort), DbName),
				    Data = Source{[Schema = "bi", Item = "station"]}[Data]
				in
				    Data

	annotation PBI_ResultType = Table
