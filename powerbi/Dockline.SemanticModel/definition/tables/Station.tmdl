/// Stations (one row per version; facts join to the version valid at the time).
table Station
	lineageTag: f139d045-d0a3-56b6-82d0-2198d13ca8d8

	/// Join key.
	column station_key
		dataType: string
		isHidden
		lineageTag: c701275f-4be2-509e-835d-e704be21c63b
		summarizeBy: none
		sourceColumn: station_key

		annotation SummarizationSetBy = Automatic

	/// GBFS station id.
	column station_id
		dataType: string
		isHidden
		lineageTag: 07768eca-e54e-5607-84f0-7b6d37fd74d3
		summarizeBy: none
