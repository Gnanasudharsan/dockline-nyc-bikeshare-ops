	column day_short_name
		dataType: string
		lineageTag: cb0b79a1-dbe8-5572-bcba-31ab14d038ff
		summarizeBy: none
		sourceColumn: day_short_name
		sortByColumn: day_of_week

		annotation SummarizationSetBy = Automatic

	column is_weekend
		dataType: boolean
		lineageTag: 3c0c003a-0389-5196-8073-9c7cd2707d87
		summarizeBy: none
		sourceColumn: is_weekend

		annotation SummarizationSetBy = Automatic

	/// Weekday or Weekend.
	column day_type
		dataType: string
		lineageTag: 43267caf-410c-5eaf-ac60-b62bc1109d49
		summarizeBy: none
		sourceColumn: day_type

		annotation SummarizationSetBy = Automatic

	column week_start_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: eea986cf-fec2-5a6a-965a-f385ef2de2d4
