		lineageTag: 41a7df19-d677-55f5-9022-7726e5c51793
		summarizeBy: none
		sourceColumn: month_short_name
		sortByColumn: month

		annotation SummarizationSetBy = Automatic

	column day_of_month
		dataType: int64
		lineageTag: 1657779e-5ad9-5c69-a4eb-a1a9375e2478
		summarizeBy: none
		sourceColumn: day_of_month

		annotation SummarizationSetBy = Automatic

	column day_of_week
		dataType: int64
		isHidden
		lineageTag: 5bba0e67-bae1-5bdf-bf51-e0b469faae75
		summarizeBy: none
		sourceColumn: day_of_week

		annotation SummarizationSetBy = Automatic

	column day_name
		dataType: string
		lineageTag: a02c676c-ab76-5bc8-94c6-00138505db39
		summarizeBy: none
		sourceColumn: day_name
		sortByColumn: day_of_week

