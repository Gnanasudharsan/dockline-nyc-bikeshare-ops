		annotation SummarizationSetBy = Automatic

	column quarter
		dataType: int64
		lineageTag: 303b70de-441c-5204-a717-bc07150444b4
		summarizeBy: none
		sourceColumn: quarter

		annotation SummarizationSetBy = Automatic

	column month
		dataType: int64
		isHidden
		lineageTag: 5a31c5c5-66a5-51f0-874b-271a912a414b
		summarizeBy: none
		sourceColumn: month

		annotation SummarizationSetBy = Automatic

	column month_name
		dataType: string
		lineageTag: f8244ebd-aaab-586e-ae19-04be75b29f52
