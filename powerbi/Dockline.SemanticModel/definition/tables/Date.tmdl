/// Calendar (New York local dates). Marked as the date table.
table Date
	dataCategory: Time
	lineageTag: 7fa180b3-890c-5d56-96da-2f1b285f1c5e

	/// Join key.
	column date_key
		dataType: int64
		isHidden
		lineageTag: ac83937e-58ed-5604-b51b-cea90d72d00b
		summarizeBy: none
		sourceColumn: date_key

		annotation SummarizationSetBy = Automatic

	/// Date.
	column calendar_date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		lineageTag: 4f459e07-8c06-598b-9d2a-dfec7621ef5e
		summarizeBy: none
		sourceColumn: calendar_date

		annotation SummarizationSetBy = Automatic

	column year
