		summarizeBy: none
		sourceColumn: month_start_date

		annotation SummarizationSetBy = Automatic

	partition Date = m
		mode: directQuery
		source =
				let
				    Source = PostgreSQL.Database(DbHost & ":" & Number.ToText(DbPort), DbName),
				    Data = Source{[Schema = "bi", Item = "date"]}[Data]
				in
				    Data

	annotation PBI_ResultType = Table
