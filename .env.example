# Dockline environment template.
# Copy to .env (`make env`) and fill in values. Never commit .env.

# --- Warehouse (PostgreSQL 16 + TimescaleDB) ---
POSTGRES_USER=dockline
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=dockline
# Host port for Postgres. 5433 avoids clashing with a locally installed Postgres on 5432.
POSTGRES_PORT=5433
# Interface Postgres binds to on the host. Keep 127.0.0.1 unless the Power BI VM
# needs access (Phase 4); then set it to the host-only/VM network interface IP.
# Never 0.0.0.0 on a public server.
POSTGRES_BIND_ADDRESS=127.0.0.1

# --- Orchestration (Dagster) ---
# Dagster UI on the host: http://localhost:3070 (3000 is left for Grafana / Next.js).
DAGSTER_PORT=3070
DAGSTER_BIND_ADDRESS=127.0.0.1
# Dagster's run/schedule storage: a separate database on the warehouse server.
DAGSTER_POSTGRES_DB=dagster

# --- Serving layer (Cube, Grafana) ---
# Read-only warehouse login used by Cube and Grafana. `make env` generates it.
DOCKLINE_READER_PASSWORD=
# Read-only login for Power BI Desktop (sees only the `bi` schema). `make env` generates it.
DOCKLINE_BI_PASSWORD=
# Cube REST API signing secret and SQL API login (Grafana connects with these).
CUBEJS_API_SECRET=
CUBEJS_SQL_USER=dockline
CUBEJS_SQL_PASSWORD=
CUBE_PORT=4000
CUBE_SQL_PORT=15432
CUBE_BIND_ADDRESS=127.0.0.1
# Cube Store publishes amd64 and arm64 builds under different tags.
# arm64 (Apple silicon, Oracle Ampere): v1.8.20-arm64v8   amd64: v1.8.20
CUBESTORE_IMAGE_TAG=v1.8.20-arm64v8
# Grafana on the host: http://localhost:3060 (3000 is left for the Next.js site). `make env` generates the password.
GRAFANA_PORT=3060
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# --- Source feeds ---
# Official auto-discovery file. Feed URLs are resolved from it at runtime.
GBFS_DISCOVERY_URL=https://gbfs.citibikenyc.com/gbfs/gbfs.json
# Preferred GBFS version, chosen from gbfs_versions.json when available.
GBFS_PREFERRED_VERSION=2.3
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
NYC_LATITUDE=40.7128
NYC_LONGITUDE=-74.0060

# --- LLM for Ask the Data (free tiers only) ---
# One of: gemini | groq | ollama
LLM_PROVIDER=groq
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- API (FastAPI) ---
API_PORT=8070
API_BIND_ADDRESS=127.0.0.1
# Ask the Data abuse limits: questions per client per minute, and for everyone per day
# (protects the free LLM quota).
ASK_RATE_PER_MINUTE=6
ASK_DAILY_LIMIT=500
# Browser origins allowed to call the API (comma separated): the website.
WEB_ORIGINS=http://localhost:3010

# --- Production (infra/docker-compose.prod.yml only) ---
# HTTPS mode on the VM: "duckdns" (Caddy + Let's Encrypt on 80/443, free subdomains)
# or "cloudflare" (Cloudflare Tunnel, needs your own domain). Leave empty locally.
COMPOSE_PROFILES=
# Public hostnames of the API and Grafana, e.g. dockline-api.duckdns.org and
# dockline-grafana.duckdns.org, or api.example.org and grafana.example.org.
PUBLIC_API_HOST=
PUBLIC_GRAFANA_HOST=
# The website's URL(s), for the API's CORS allowlist, e.g. https://dockline.vercel.app
PROD_WEB_ORIGINS=
# duckdns mode: subdomain names without .duckdns.org (comma separated), and your token.
DUCKDNS_DOMAINS=
DUCKDNS_TOKEN=
# cloudflare mode: token from Cloudflare Zero Trust > Networks > Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=
# Nightly backups: local hour (0-23) and how many dumps to keep.
BACKUP_HOUR=3
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_PATH=./backups

# --- General ---
TZ=America/New_York
LOG_LEVEL=INFO
