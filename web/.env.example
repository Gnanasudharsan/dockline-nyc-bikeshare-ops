# Dockline API (FastAPI). The browser calls it directly; add the site's origin to the
# API's WEB_ORIGINS.
NEXT_PUBLIC_API_URL=http://localhost:8070
# Public Grafana dashboard for the Live page (`make grafana-public` prints the URL).
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3060
NEXT_PUBLIC_GRAFANA_PUBLIC_DASHBOARD=
# Canonical site URL for OG tags and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3010
# Deployment mode (ADR 0022): "full" (the self-hosted stack) or "snapshot" (Vercel only:
# /api/live reads the public feed; history comes from the repository's data branch).
NEXT_PUBLIC_DEPLOY_MODE=full
# Optional: a recording of the full stack, linked from the Ask page in snapshot mode.
NEXT_PUBLIC_DEMO_VIDEO_URL=
