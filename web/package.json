{
  "name": "dockline-web",
  "version": "0.6.0",
  "private": true,
  "description": "Dockline website: live operations intelligence for NYC bike share.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --port 3010",
    "build": "next build",
    "start": "next start --port 3010",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --no-warnings --test test/metrics-parity.test.mjs",
    "test:e2e": "playwright test",
    "screenshots": "playwright test --project=screenshots"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "maplibre-gl": "5.24.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3"
  }
}
